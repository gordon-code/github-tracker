{
  "name": "github-tracker",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.workspace.ts",
    "test:watch": "vitest --config vitest.workspace.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --build src/shared/tsconfig.json && tsc --build mcp/tsconfig.json && tsc -p tsconfig.lint.json",
    "lint": "oxlint --type-aware --tsconfig tsconfig.lint.json --deny-warnings src tests e2e mcp/tests vite.config.ts vitest.config.ts vitest.smoke.config.ts vitest.workspace.ts playwright.config.ts playwright.config.screenshot.ts mcp/tsup.config.ts mcp/vitest.config.ts && oxlint --type-aware --tsconfig mcp/tsconfig.json --deny-warnings mcp/src",
    "lint:fix": "oxlint --type-aware --tsconfig tsconfig.lint.json --fix src tests e2e mcp/tests vite.config.ts vitest.config.ts vitest.smoke.config.ts vitest.workspace.ts playwright.config.ts playwright.config.screenshot.ts mcp/tsup.config.ts mcp/vitest.config.ts && oxlint --type-aware --tsconfig mcp/tsconfig.json --fix mcp/src",
    "test:e2e": "E2E_PORT=$(node -e \"const s=require('net').createServer();s.listen(0,()=>{console.log(s.address().port);s.close()})\") playwright test",
    "test:waf": "bash scripts/waf-smoke-test.sh",
    "test:status-smoke": "vitest run --config vitest.smoke.config.ts",
    "screenshot": "pnpm exec playwright test --config playwright.config.screenshot.ts",
    "mcp:serve": "pnpm --filter github-tracker-mcp dev",
    "validate:deploy": "bash scripts/validate-deploy.sh",
    "bundle:report": "bash scripts/bundle-report.sh"
  },
  "dependencies": {
    "@kobalte/core": "0.13.14",
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-rest": "16.0.0",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@sentry/cloudflare": "11.12.0",
    "@sentry/solid": "11.12.0",
    "@solidjs/router": "1.0.3",
    "idb": "8.0.4",
    "solid-js": "1.9.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@fast-check/vitest": "0.5.0",
    "@playwright/test": "1.65.1",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "daisyui": "5.8.0",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "rollup-plugin-visualizer": "7.1.3",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.16",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
